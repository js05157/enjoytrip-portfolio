<%@ page pageEncoding="UTF-8" %>
<%@ include file="../fragments/header.jspf" %><section class="form-card"><p class="eyebrow">YOUR TRAVEL COMPANION</p><h1>함께 여행을 시작해요</h1><form method="post" action="<c:url value='/auth/register'/>"><input type="hidden" name="csrf" value="${sessionScope.csrf}"><div class="field"><label for="email">이메일</label><input id="email" type="email" name="email" required maxlength="254" autocomplete="email" value="<c:out value='${param.email}'/>"></div><div class="field"><label for="name">이름</label><input id="name" name="name" required maxlength="40" autocomplete="name" value="<c:out value='${param.name}'/>"></div><div class="field"><label for="password">비밀번호 (10~128자)</label><input id="password" type="password" name="password" required maxlength="128" autocomplete="new-password" minlength="10"></div><button class="primary">회원가입</button></form><div class="form-links"><a href="<c:url value='/auth/login'/>">로그인으로 돌아가기</a><a href="<c:url value='/auth/forgot'/>">비밀번호 찾기</a></div></section><%@ include file="../fragments/footer.jspf" %>
