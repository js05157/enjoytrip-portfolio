<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!DOCTYPE html><html lang="ko"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>EnjoyTrip · 함께 떠나는 여행</title><link rel="stylesheet" href="<c:url value='/assets/css/app.css'/>"><link rel="stylesheet" href="<c:url value='/assets/vendor/leaflet/leaflet.css'/>"><script defer src="<c:url value='/assets/vendor/leaflet/leaflet.js'/>"></script><script defer src="<c:url value='/assets/js/app.js'/>"></script></head><body>
<header class="nav"><a class="brand" href="<c:url value='/'/>">EnjoyTrip<span>우리의 여행 지도</span></a><nav aria-label="주 메뉴"><a href="<c:url value='/attractions'/>">여행지 찾기</a><a href="<c:url value='/plans'/>">나의 여행</a><a href="<c:url value='/places'/>">핫플레이스</a><a href="<c:url value='/community'/>">커뮤니티</a><a href="<c:url value='/news'/>">여행 소식</a><a href="<c:url value='/travel-info'/>">여행 도구</a><c:choose><c:when test="${not empty sessionScope.member}"><a href="<c:url value='/members/me'/>"><c:out value="${sessionScope.member.name}"/> 님</a><form method="post" action="<c:url value='/auth/logout'/>"><input type="hidden" name="csrf" value="${sessionScope.csrf}"><button class="link">로그아웃</button></form></c:when><c:otherwise><a href="<c:url value='/auth/login'/>">로그인</a><a class="button small" href="<c:url value='/auth/register'/>">회원가입</a></c:otherwise></c:choose></nav></header>
<main class="container"><c:if test="${applicationScope.demo}"><aside class="notice">개발 모드 · 관광지는 샘플 데이터입니다. 실제 관광 정보는 TourAPI 연결 후 제공됩니다.</aside></c:if><c:if test="${not empty sessionScope.flash}"><div class="notice success" role="status"><c:out value="${sessionScope.flash}"/></div><c:remove var="flash" scope="session"/></c:if><c:if test="${not empty error}"><div class="notice error" role="alert"><c:out value="${error}"/></div></c:if>
