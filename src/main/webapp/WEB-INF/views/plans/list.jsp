<%@ page pageEncoding="UTF-8" %>
<%@ include file="../fragments/header.jspf" %><p class="eyebrow">MAKE YOUR OWN ROUTE</p><h1 class="page-title">나의 여행</h1><div class="grid"><c:forEach var="plan" items="${plans}"><a class="card feature" href="<c:url value='/plans/detail'/>?id=${plan.id}"><span class="tag"><c:out value="${plan.startDate}"/> ~ <c:out value="${plan.endDate}"/></span><h2><c:out value="${plan.title}"/></h2><p>예산 <c:out value="${plan.budget}"/>원</p></a></c:forEach></div><c:if test="${empty plans}"><p class="muted">아직 여행 일정이 없어요. 첫 여행을 만들어 보세요.</p></c:if><section class="form-card"><h2>새 여행 만들기</h2><form method="post" action="<c:url value='/plans/create'/>"><input type="hidden" name="csrf" value="${sessionScope.csrf}"><div class="field"><label for="title">여행 이름</label><input id="title" name="title" required maxlength="100"></div><div class="row"><div class="field"><label for="start">시작일</label><input id="start" name="start" type="date" required></div><div class="field"><label for="end">종료일</label><input id="end" name="end" type="date" required></div></div><div class="field"><label for="budget">예산 (원)</label><input id="budget" name="budget" type="number" min="0" max="1000000000" value="0"></div><div class="field"><label for="description">여행 메모</label><textarea id="description" name="description" maxlength="3000"></textarea></div><button class="primary">여행 만들기</button></form></section><%@ include file="../fragments/footer.jspf" %>
