<%@ include file="../fragments/header.jspf" %><p class="eyebrow">OUR HIDDEN GEMS</p><h1 class="page-title">사진으로 남긴 나의 핫플레이스</h1><div class="grid"><c:forEach var="place" items="${places}"><article class="card"><img src="<c:url value='/photos/'/>${place.photo}" alt="<c:out value='${place.title}'/>" loading="lazy"><div class="card-body"><span class="tag"><c:out value="${place.type}"/></span><h2><c:out value="${place.title}"/></h2><p><c:out value="${place.address}"/></p><p class="prose"><c:out value="${place.description}"/></p><p class="muted"><c:out value="${place.author}"/> · <c:out value="${place.visitedOn}"/></p><a class="button secondary small" href="https://www.openstreetmap.org/?mlat=${place.latitude}&amp;mlon=${place.longitude}#map=16/${place.latitude}/${place.longitude}" target="_blank" rel="noopener noreferrer">지도에서 보기</a></div></article></c:forEach></div><div class="pagination"><c:if test="${page gt 1}"><a href="?page=${page-1}">이전</a></c:if><span>${page} 페이지</span><c:if test="${hasNext}"><a href="?page=${page+1}">다음</a></c:if></div><c:choose><c:when test="${empty sessionScope.member}"><p class="empty"><a class="button" href="<c:url value='/auth/login'/>">로그인하고 여행 사진 남기기</a></p></c:when><c:otherwise><section class="form-card"><h2>나만의 장소 등록</h2><form method="post" action="<c:url value='/places/create'/>" enctype="multipart/form-data"><input type="hidden" name="csrf" value="${sessionScope.csrf}"><div class="field"><label for="placeTitle">장소 이름</label><input id="placeTitle" name="title" required maxlength="100"></div><div class="field"><label for="placeAddress">주소</label><input id="placeAddress" name="address" required maxlength="300"></div><div class="field"><label for="placeType">장소 유형</label><select id="placeType" name="type"><option>관광지</option><option>음식점</option><option>카페</option><option>숙박</option><option>기타</option></select></div><div class="field"><label for="visitedOn">다녀온 날짜</label><input id="visitedOn" name="visitedOn" type="date" required></div><div class="row"><div class="field"><label for="latitude">위도</label><input id="latitude" name="latitude" type="number" step="any" min="-90" max="90" required></div><div class="field"><label for="longitude">경도</label><input id="longitude" name="longitude" type="number" step="any" min="-180" max="180" required></div></div><div class="field"><label for="description">여행 이야기</label><textarea id="description" name="description" maxlength="3000"></textarea></div><div class="field"><label for="photo">사진 (JPEG·PNG, 5MB·1200만 화소 이하)</label><input id="photo" name="photo" type="file" accept="image/jpeg,image/png" required></div><button class="primary">사진과 장소 등록</button></form></section></c:otherwise></c:choose><%@ include file="../fragments/footer.jspf" %>
