<%@ include file="../fragments/header.jspf" %><p class="eyebrow">TRAVEL TOGETHER</p><h1 class="page-title">여행 이야기</h1><div class="toolbar"><a class="button ${board eq 'share' ? '' : 'secondary'}" href="<c:url value='/community'/>?board=share">공유게시판</a><a class="button ${board eq 'notice' ? '' : 'secondary'}" href="<c:url value='/community'/>?board=notice">공지사항</a><c:if test="${not empty sessionScope.member and (board ne 'notice' or admin)}"><a class="button secondary" href="<c:url value='/community/new'/>?board=${board}">글쓰기</a></c:if></div><div class="table-wrap"><table><thead><tr><th>제목</th><th>작성자</th><th>등록일</th></tr></thead><tbody><c:forEach var="post" items="${posts}"><tr><td><a href="<c:url value='/community/detail'/>?id=${post.id}"><c:out value="${post.title}"/></a></td><td><c:out value="${post.author}"/></td><td><c:out value="${post.createdAt}"/></td></tr></c:forEach></tbody></table></div><c:if test="${empty posts}"><p class="empty">아직 등록된 글이 없어요.</p></c:if><div class="pagination"><c:if test="${page gt 1}"><a href="?board=${board}&amp;page=${page-1}">이전</a></c:if><span>${page} 페이지</span><c:if test="${hasNext}"><a href="?board=${board}&amp;page=${page+1}">다음</a></c:if></div><%@ include file="../fragments/footer.jspf" %>
