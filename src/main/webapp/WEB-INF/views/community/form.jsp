<%@ include file="../fragments/header.jspf" %><article class="detail"><h1 class="page-title">${empty post ? '새 이야기 작성' : '이야기 수정'}</h1><c:url var="saveUrl" value="${empty post ? '/community/create' : '/community/update'}"/><form method="post" action="${saveUrl}"><input type="hidden" name="csrf" value="${sessionScope.csrf}"><input type="hidden" name="board" value="${board}"><input type="hidden" name="id" value="${post.id}"><div class="field"><label for="title">제목</label><input id="title" name="title" required maxlength="200" value="<c:out value='${post.title}'/>"></div><div class="field"><label for="body">내용</label><textarea id="body" name="body" required maxlength="10000"><c:out value="${post.body}"/></textarea></div><p><button class="primary">저장</button></p></form></article><%@ include file="../fragments/footer.jspf" %>
