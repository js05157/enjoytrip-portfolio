<%@ include file="../fragments/header.jspf" %><article class="detail"><span class="tag">${board eq 'notice' ? '공지사항' : '공유게시판'}</span><h1 class="page-title"><c:out value="${post.title}"/></h1><p class="muted"><c:out value="${post.author}"/> · <c:out value="${post.createdAt}"/></p><div class="prose"><c:out value="${post.body}"/></div><div class="toolbar"><a class="button secondary" href="<c:url value='/community'/>?board=${board}">목록</a><c:if test="${editable}"><a class="button" href="<c:url value='/community/edit'/>?id=${post.id}">수정</a><form method="post" action="<c:url value='/community/delete'/>" data-confirm="이 글을 삭제할까요?"><input type="hidden" name="csrf" value="${sessionScope.csrf}"><input type="hidden" name="id" value="${post.id}"><button class="button danger">삭제</button></form></c:if></div></article><%@ include file="../fragments/footer.jspf" %>
