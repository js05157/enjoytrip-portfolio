<%@ include file="../fragments/header.jspf" %><article class="detail"><a class="muted" href="<c:url value='/attractions'/>">← 여행지 목록</a><p class="eyebrow"><c:out value="${item.typeName}"/></p><h1 class="page-title"><c:out value="${item.title}"/></h1><p class="muted"><c:out value="${item.address}"/></p><c:if test="${not empty item.image}"><img src="<c:out value='${item.image}'/>" alt="여행지 사진"></c:if><p class="prose"><c:out value="${item.overview}"/></p><c:if test="${item.hasCoordinates}"><iframe class="map" title="여행지 위치 · OpenStreetMap" src="<c:out value='${item.mapUrl}'/>" loading="lazy"></iframe><p class="muted">지도: © OpenStreetMap contributors</p></c:if><h2>내 일정에 담기</h2><c:forEach var="plan" items="${plans}"><c:url var="addUrl" value="/plans/detail"><c:param name="id" value="${plan.id}"/><c:param name="contentId" value="${item.contentId}"/></c:url><p><a class="button secondary" href="${addUrl}"><c:out value="${plan.title}"/>에 담기</a></p></c:forEach><a class="button" href="<c:url value='/plans'/>">여행 일정 만들기</a></article><%@ include file="../fragments/footer.jspf" %>
