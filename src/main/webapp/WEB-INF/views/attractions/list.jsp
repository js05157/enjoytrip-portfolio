<%@ include file="../fragments/header.jspf" %>
<p class="eyebrow">FIND YOUR PLACE</p><h1 class="page-title">지금, 떠나고 싶은 곳</h1>
<form class="search" method="get" action="<c:url value='/attractions'/>">
 <div class="field"><label for="area">지역</label><select id="area" name="area" data-areas-url="<c:url value='/attractions/areas'/>"><option value="">전국</option><c:forEach var="region" items="${regions}"><option value="${region.key}" ${param.area eq region.key ? 'selected' : ''}><c:out value="${region.value}"/></option></c:forEach></select></div>
 <div class="field"><label for="district">시·군·구</label><select id="district" name="district"><option value="">전체</option><c:forEach var="d" items="${districts}"><option value="${d.code}" ${param.district eq d.code ? 'selected' : ''}><c:out value="${d.name}"/></option></c:forEach></select></div>
 <div class="field"><label for="type">어떤 여행?</label><select id="type" name="type"><option value="">전체 유형</option><c:forEach var="type" items="${types}"><option value="${type.key}" ${param.type eq type.key ? 'selected' : ''}><c:out value="${type.value}"/></option></c:forEach></select></div>
 <div class="field"><label for="keyword">검색어</label><input id="keyword" name="keyword" value="<c:out value='${param.keyword}'/>" maxlength="100" placeholder="여행지 이름 또는 주소"></div>
 <div class="field"><label for="sort">정렬</label><select name="sort" id="sort"><option value="A" ${param.sort eq 'A' ? 'selected' : ''}>이름순</option><option value="C" ${param.sort eq 'C' ? 'selected' : ''}>수정일순</option><option value="D" ${param.sort eq 'D' ? 'selected' : ''}>등록일순</option></select></div><button class="primary">검색</button>
</form><p class="muted">총 <c:out value="${result.total}"/>개의 여행지</p>
<div class="grid"><c:forEach var="item" items="${result.items}"><c:url var="detailUrl" value="/attractions/detail"><c:param name="id" value="${item.contentId}"/></c:url><a class="card" href="${detailUrl}"><c:choose><c:when test="${not empty item.image}"><img src="<c:out value='${item.image}'/>" alt="" loading="lazy"></c:when><c:otherwise><div class="placeholder" aria-hidden="true">↗</div></c:otherwise></c:choose><div class="card-body"><span class="tag"><c:out value="${item.typeName}"/></span><h3><c:out value="${item.title}"/></h3><p><c:out value="${item.address}"/></p></div></a></c:forEach></div>
<c:if test="${empty result.items}"><div class="empty"><h2>검색 결과가 없어요.</h2><p>지역이나 검색어를 바꿔보세요.</p></div></c:if>
<div class="pagination"><c:if test="${page gt 1}"><a class="button secondary small" href="<c:out value='${query.previous}'/>">이전</a></c:if><span><c:out value="${page}"/> 페이지</span><c:if test="${hasNext}"><a class="button secondary small" href="<c:out value='${query.next}'/>">다음</a></c:if></div>
<%@ include file="../fragments/footer.jspf" %>
