<%@ include file="../fragments/header.jspf" %><section class="form-card"><p class="eyebrow">MY ACCOUNT</p><h1>나의 회원 정보</h1><form method="post" action="<c:url value='/members/update'/>"><input type="hidden" name="csrf" value="${sessionScope.csrf}"><div class="field"><label for="email">이메일</label><input id="email" name="email" type="email" required maxlength="254" value="<c:out value='${sessionScope.member.email}'/>"></div><div class="field"><label for="name">이름</label><input id="name" name="name" required maxlength="40" value="<c:out value='${sessionScope.member.name}'/>"></div><div class="field"><label for="password">현재 비밀번호 (수정 확인)</label><input id="password" name="password" type="password" required autocomplete="current-password" maxlength="128"></div><div class="field"><label for="newPassword">새 비밀번호 (변경할 때만 입력)</label><input id="newPassword" name="newPassword" type="password" minlength="10" maxlength="128" autocomplete="new-password"></div><button class="primary">변경 저장</button></form><hr><h2>회원 탈퇴</h2><p class="muted">회원 정보와 나의 여행 데이터가 삭제됩니다.</p><form method="post" action="<c:url value='/members/delete'/>" data-confirm="정말 탈퇴하시겠습니까? 되돌릴 수 없습니다."><input type="hidden" name="csrf" value="${sessionScope.csrf}"><label for="deletePassword">현재 비밀번호</label><input id="deletePassword" name="password" type="password" required autocomplete="current-password" maxlength="128"><p><button class="button danger">회원 탈퇴</button></p></form></section><%@ include file="../fragments/footer.jspf" %>
