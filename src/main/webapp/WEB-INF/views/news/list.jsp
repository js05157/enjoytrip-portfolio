<%@ page pageEncoding="UTF-8" %>
<%@ include file="../fragments/header.jspf" %><p class="eyebrow">TRAVEL IN THE NEWS</p><h1 class="page-title">여행 소식</h1><p class="muted">국내 관광·여행 관련 뉴스의 제목과 원문 링크를 모았습니다. 제공: Google 뉴스 RSS · 기사 저작권은 각 언론사에 있습니다.</p><c:if test="${admin}"><form method="post" action="<c:url value='/news/collect'/>"><input type="hidden" name="csrf" value="${sessionScope.csrf}"><button class="button secondary">새 뉴스 수집</button></form></c:if><c:forEach var="article" items="${articles}"><article class="list-item"><p class="eyebrow"><c:out value="${article.source}"/></p><h2><a href="<c:out value='${article.url}'/>" target="_blank" rel="noopener noreferrer nofollow"><c:out value="${article.title}"/> ↗</a></h2><p class="muted"><c:out value="${article.publishedAt}"/></p></article></c:forEach><c:if test="${empty articles}"><div class="empty">아직 수집된 뉴스가 없어요.</div></c:if><div class="pagination"><c:if test="${page gt 1}"><a href="?page=${page-1}">이전</a></c:if><span>${page} 페이지</span><c:if test="${hasNext}"><a href="?page=${page+1}">다음</a></c:if></div><%@ include file="../fragments/footer.jspf" %>
