# config/application-local.properties로 복사 (Git 제외)
# JVM 옵션 -Denjoytrip.config=C:/절대경로/enjoytrip/config/application-local.properties
# 또는 환경 변수 APP_CONFIG에 절대 경로 지정
app.mode=demo
app.base-url=http://localhost:8080/enjoytrip
# 실제 서비스는 app.mode=live 및 MySQL/TourAPI/SMTP 설정 필요
# db.url=jdbc:mysql://localhost:3306/enjoytrip?serverTimezone=Asia/Seoul&characterEncoding=UTF-8
# db.user=enjoytrip
# db.password=개인_비밀번호
# tour.service-key=공공데이터포털_Decoding_인증키
weather.base-url=https://api.open-meteo.com/v1/forecast
# 한국환경공단 전기자동차 충전소 정보 활용 신청 후 발급한 Decoding 키
ev.service-key=
redis.enabled=true
redis.uri=redis://localhost:16379/0
redis.ttl-seconds=600
# smtp.host=smtp.example.com
# smtp.port=587
# smtp.user=
# smtp.password=
# smtp.from=

# 공지사항 작성과 뉴스 수집 관리자 (쉼표로 구분)
app.admin-emails=
